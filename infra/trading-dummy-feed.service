[Unit]
Description=Trading Dummy Feed Seeder
After=network-online.target redis.service influxdb.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/trading
EnvironmentFile=/root/trading/.env
ExecStart=/root/trading/.venv/bin/python -m infra.dummy_feed
Restart=on-failure
RestartSec=30
User=root

[Install]
WantedBy=multi-user.target
