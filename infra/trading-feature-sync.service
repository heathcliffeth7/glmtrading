[Unit]
Description=AI Trading Feature Sync Service (TwelveData -> InfluxDB)
After=network.target influxdb.service redis.service
Wants=influxdb.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading
Environment="PATH=/root/trading/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/root/trading/.venv/bin/python -m app.data_feeds.twelve_data_feature_feed --symbol "BTC/USD" --binance-symbol BTCUSDT --interval 30min --poll-interval 1800
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-feature-sync

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
