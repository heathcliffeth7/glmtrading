[Unit]
Description=Trading Dashboard Frontend Static Server
After=network-online.target trading-dashboard-api.service
Wants=trading-dashboard-api.service

[Service]
Type=simple
WorkingDirectory=/root/trading/frontend
ExecStart=/usr/bin/python3 -m http.server 3000
Restart=on-failure
RestartSec=10
User=root

# Resource limits
MemoryMax=256M
CPUQuota=20%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-dashboard-frontend

[Install]
WantedBy=multi-user.target
