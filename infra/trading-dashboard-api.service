[Unit]
Description=Trading Dashboard FastAPI Backend
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/root/trading
EnvironmentFile=/root/trading/.env
ExecStart=/root/trading/.venv/bin/uvicorn app.api.main:app --host 0.0.0.0 --port 8001 --workers 4 --log-level info
Restart=on-failure
RestartSec=10
User=root

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-dashboard-api

[Install]
WantedBy=multi-user.target
