[Unit]
Description=AI Trading Enriched Data Feed - ETH 4h Long-term
After=network.target influxdb.service redis.service
Wants=influxdb.service redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading
Environment="PATH=/root/trading/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/root/trading/.venv/bin/python -m app.data_feeds.enriched_feed --symbol ETHUSDT --interval 4h --poll-interval 14400
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-enriched-feed-eth-4h

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
